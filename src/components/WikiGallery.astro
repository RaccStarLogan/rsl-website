---
import defaultPlaceholder from "../assets/placeholder.png";

type WikiGalleryImage = {
  src: string | { src: string };
  alt: string;
  label?: string;
  caption?: string;
  captionHtml?: string;
};

type NormalizedWikiGalleryImage = WikiGalleryImage & {
  resolvedSrc: string;
};

const {
  title = "",
  images = [],
  initialIndex = 0,
  ariaLabel = "Image gallery"
} = Astro.props as {
  title?: string;
  images?: WikiGalleryImage[];
  initialIndex?: number;
  ariaLabel?: string;
};

const normalizedImages: NormalizedWikiGalleryImage[] = images
  .filter((image) => image && image.src && image.alt)
  .map((image) => ({
    ...image,
    resolvedSrc: typeof image.src === "string" ? image.src : image.src.src
  }));

const renderedImages: NormalizedWikiGalleryImage[] = normalizedImages.length > 0
  ? normalizedImages
  : [{
      src: defaultPlaceholder,
      alt: "Default placeholder image",
      label: "Placeholder",
      caption: "",
      resolvedSrc: defaultPlaceholder.src
    }];

const showTabs = renderedImages.length > 1;

const safeInitialIndex = Math.max(0, Math.min(initialIndex, Math.max(0, renderedImages.length - 1)));
const galleryId = `wiki-gallery-${Math.random().toString(36).slice(2, 10)}`;
---

<section class="wiki-gallery" data-wiki-gallery id={galleryId}>
  {title && <h3 class="wiki-gallery-title">{title}</h3>}

  {showTabs && (
    <div class="wiki-gallery-tabs-wrap">
      <button
        type="button"
        class="wiki-gallery-scroll wiki-gallery-scroll--prev"
        data-gallery-scroll="prev"
        aria-label="Scroll gallery tabs left"
      >
        &#9664;
      </button>
      <div class="wiki-gallery-tabs" role="tablist" aria-label={ariaLabel}>
        {renderedImages.map((image, index) => (
          <button
            type="button"
            class={`wiki-gallery-tab${index === safeInitialIndex ? " is-active" : ""}`}
            role="tab"
            aria-selected={index === safeInitialIndex ? "true" : "false"}
            aria-controls={`${galleryId}-panel-${index}`}
            id={`${galleryId}-tab-${index}`}
            data-gallery-tab
            data-index={index}
          >
            {image.label ?? `Image ${index + 1}`}
          </button>
        ))}
      </div>
      <button
        type="button"
        class="wiki-gallery-scroll wiki-gallery-scroll--next"
        data-gallery-scroll="next"
        aria-label="Scroll gallery tabs right"
      >
        &#9654;
      </button>
    </div>
  )}

    <div class="wiki-gallery-panels">
      {renderedImages.map((image, index) => (
        <figure
          class="wiki-gallery-panel"
          id={`${galleryId}-panel-${index}`}
          role={showTabs ? "tabpanel" : undefined}
          aria-labelledby={showTabs ? `${galleryId}-tab-${index}` : undefined}
          data-gallery-panel
          data-index={index}
          hidden={index !== safeInitialIndex}
        >
          <img class="wiki-gallery-image" src={image.resolvedSrc} alt={image.alt} loading="lazy" />
          {image.captionHtml
            ? <figcaption class="wiki-gallery-caption" set:html={image.captionHtml} />
            : (image.caption && <figcaption class="wiki-gallery-caption">{image.caption}</figcaption>)}
        </figure>
      ))}
    </div>
</section>

<script is:inline>
  document.querySelectorAll("[data-wiki-gallery]").forEach((gallery) => {
    if (gallery.dataset.initialized === "true") return;
    gallery.dataset.initialized = "true";

    const tabs = Array.from(gallery.querySelectorAll("[data-gallery-tab]"));
    const panels = Array.from(gallery.querySelectorAll("[data-gallery-panel]"));
    const tabsWrap = gallery.querySelector(".wiki-gallery-tabs-wrap");
    const tabsRow = gallery.querySelector(".wiki-gallery-tabs");
    const prevScrollButton = gallery.querySelector("[data-gallery-scroll='prev']");
    const nextScrollButton = gallery.querySelector("[data-gallery-scroll='next']");
    if (tabs.length === 0 || panels.length === 0) return;

    const setActive = (index) => {
      tabs.forEach((tab, tabIndex) => {
        const isActive = tabIndex === index;
        tab.classList.toggle("is-active", isActive);
        tab.setAttribute("aria-selected", isActive ? "true" : "false");
        tab.setAttribute("tabindex", isActive ? "0" : "-1");
      });

      panels.forEach((panel, panelIndex) => {
        panel.hidden = panelIndex !== index;
      });

      tabs[index]?.scrollIntoView({
        behavior: "smooth",
        block: "nearest",
        inline: "center"
      });
    };

    const updateScrollButtons = () => {
      if (!tabsRow || !prevScrollButton || !nextScrollButton) return;
      const maxLeft = tabsRow.scrollWidth - tabsRow.clientWidth;
      const left = Math.max(0, tabsRow.scrollLeft);
      prevScrollButton.disabled = left <= 1;
      nextScrollButton.disabled = left >= maxLeft - 1;
    };

    const updateOverflowState = () => {
      if (!tabsWrap || !tabsRow) return;
      const isOverflowing = tabsRow.scrollWidth > tabsRow.clientWidth + 1;
      tabsWrap.classList.toggle("is-overflowing", isOverflowing);
    };

    const scrollTabs = (direction) => {
      if (!tabsRow) return;
      const amount = Math.max(120, Math.floor(tabsRow.clientWidth * 0.6));
      tabsRow.scrollBy({
        left: direction === "next" ? amount : -amount,
        behavior: "smooth"
      });
    };

    let activeIndex = tabs.findIndex((tab) => tab.classList.contains("is-active"));
    if (activeIndex < 0) activeIndex = 0;
    setActive(activeIndex);

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        activeIndex = index;
        setActive(activeIndex);
      });

      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        event.preventDefault();

        if (event.key === "ArrowRight") activeIndex = (activeIndex + 1) % tabs.length;
        if (event.key === "ArrowLeft") activeIndex = (activeIndex - 1 + tabs.length) % tabs.length;
        if (event.key === "Home") activeIndex = 0;
        if (event.key === "End") activeIndex = tabs.length - 1;

        setActive(activeIndex);
        tabs[activeIndex].focus();
      });
    });

    if (prevScrollButton) {
      prevScrollButton.addEventListener("click", () => scrollTabs("prev"));
    }
    if (nextScrollButton) {
      nextScrollButton.addEventListener("click", () => scrollTabs("next"));
    }
    if (tabsRow) {
      tabsRow.addEventListener("scroll", updateScrollButtons, { passive: true });
      window.addEventListener("resize", () => {
        updateOverflowState();
        updateScrollButtons();
      }, { passive: true });
    }
    updateOverflowState();
    updateScrollButtons();
  });
</script>
