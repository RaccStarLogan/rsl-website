---
// Metadata for the page, with defaults
const {
    title = "RaccStarLogan",
    description = "RaccStarLogan's personal website",
    image = "/default-embed.png",
    url = "https://raccstarlogan.com"
} = Astro.props;
// Imports
import headerLogoRaw from "../assets/headerlogo.svg?raw";
import Announcement from "../components/Announcement.astro";
const showAnnouncement = true; // Set to true to show the announcement banner
const headerLogoMarkup = headerLogoRaw.replace(
  "<svg ",
  '<svg class="site-header-logo" aria-hidden="true" focusable="false" '
);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
    <slot name="head" />
    <!-- Favicon and Stylesheet -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/style.css" />
    <script src="/scripts/april-fools.js" defer></script>
  </head>
  <body>
    <!-- Announcement Banner -->
    {showAnnouncement && (
      <Announcement text="V3 is currently in Alpha! Expect bugs." link="#" />
    )}
    <!-- Header and Navigation -->
    <header>
      <nav class="navbar">
        <div class="logo-section">
          <a href="/" aria-label="RaccStarLogan home">
            <span class="logo-svg-wrap" set:html={headerLogoMarkup}></span>
          </a>
        </div>
        <!-- Navigation Links -->
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="/links">Links</a></li>
          <li><a href="/portfolio">Portfolio</a></li>
          <li><a href="/commissions">Commissions</a></li>
          <li><a href="https://shop.raccstarlogan.com">Merch</a></li>
          <li><a href="/wiki">Wiki</a></li>
        </ul>
      </nav>
    </header>
    <!-- Main Content -->
    <main>
      <slot />
    </main>
    <!-- Footer -->
    <footer>
      <li><p>V3 ALPHA TESTING!!!</p></li>
      <li><p>-</p></li>
      <li><p>&copy; 2019-2026 RaccStarLogan</p></li>
      <li><p>-</p></li>
      <li><p>All rights reserved</p></li>
      <li><p>-</p></li>
      <li><a href="mailto:contact@raccstarlogan.com">Contact</a></li>
      <li><p>-</p></li>
      <li><a href="/nsfw">18+ Page</a></li>
    </footer>
  </body>
</html>

<style>
  .logo-svg-wrap {
    display: block;
    line-height: 0;
  }

  .logo-svg-wrap :global(.site-header-logo) {
    display: block;
    height: 92px;
    width: auto;
  }
</style>
