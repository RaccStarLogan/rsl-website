---
const { title = "RaccStarLogan" } = Astro.props;
import { Image } from "astro:assets";
import headerlogo from "../assets/headerlogo.svg";
import Announcement from "../components/Announcement.astro";
const showAnnouncement = true; // Set to true to show the announcement banner
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    {showAnnouncement && (
      <Announcement text="V3 is currently in alpha! Expect bugs." />
    )}
    <header>
      <nav class="navbar">
        <div class="logo-section">
          <a href="/">
            <Image src={headerlogo} alt="RaccStarLogan Logo" class="logo" height="92" loading="eager" />
          </a>
        </div>
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="/links">Links</a></li>
          <li><a href="/portfolio">Portfolio</a></li>
          <li><a href="/commissions">Commissions</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <li><p>V3 ALPHA TESTING!!!</p></li>
      <li><p>-</p></li>
      <li><p>&copy; 2019-2026 RaccStarLogan</p></li>
      <li><p>-</p></li>
      <li><p>All rights reserved</p></li>
      <li><p>-</p></li>
      <li><a href="mailto:contact@raccstarlogan.com">Contact</a></li>
      <li><p>-</p></li>
      <li><a href="/confirm-age">18+ Page</a></li>
    </footer>
  </body>
</html>