---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WikiTOC from "../../../components/WikiTOC.astro";
import WikiInfoBox from "../../../components/WikiInfoBox.astro";
import WikiAccordion from "../../../components/WikiAccordion.astro";
import { getWikiEntry } from "../../../data/wikiEntries";

const wikiEntry = getWikiEntry("upa");
---
<BaseLayout title="Wiki - United Provinces of Avalona" description="Placeholder location page.">
  <meta slot="head" name="wiki:type" content={wikiEntry.meta.type.toLowerCase()} />
  <meta slot="head" name="wiki:tags" content={wikiEntry.meta.tags.join(",")} />
  <link rel="stylesheet" href="/wiki.css" />
  <link rel="stylesheet" href={wikiEntry.stylesheet} />
  <div class="wiki-page-grid">
    <aside class="wiki-sidebar">
      <h2>Info box</h2>
      <table>
        <tr>
          <th>Inspiration</th>
          <td><a href="https://en.wikipedia.org/wiki/United_States" target="_blank" rel="noopener noreferrer">United States</a></td>
        </tr>
        <tr>
          <th>Notes</th>
          <td>the united states but if donald trump was never president and we decided to call them provinces instead of states. also for some reason communication systems are different but that's just the world not avalona specifically</td>
        </tr>
      </table>
    </aside>

    <main id="wiki-content" class="article-section">
      <h1>United Provinces of Avalona</h1>
      <WikiInfoBox title="Note" variant="warning">
        This location page is a work in progress. Information may be incomplete or subject to change as the wiki is developed.
      </WikiInfoBox>
      <p><strong>United Provinces of Avalona</strong> is the largest and most populous country in Avalona, encompassing a vast and diverse range of landscapes, cultures, and climates. It serves as the primary setting for many of the events in the world of Avalona and is home to a wide variety of characters, locations, and stories. The country draws heavy inspiration from the United States, incorporating elements of its geography, culture, and history into the world of Avalona.</p>
      <div class="wiki-toc-wrapper"><WikiTOC /></div>

      <h2 id="overview">Overview</h2>
      <p>Starter location page for United Provinces of Avalona.</p>

      <WikiAccordion summary="Ideas to add later">
        <ul>
          <li>Regional overview and map notes</li>
          <li>Major cities and political structure</li>
          <li>Important historical events</li>
        </ul>
      </WikiAccordion>
    </main>
  </div>
</BaseLayout>
