---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WikiTOC from "../../../components/WikiTOC.astro";
import WikiInfoBox from "../../../components/WikiInfoBox.astro";
import WikiAccordion from "../../../components/WikiAccordion.astro";
import WikiGallery from "../../../components/WikiGallery.astro";
import { getWikiEntry } from "../../../data/wikiEntries";

const wikiEntry = getWikiEntry("zeke-harborne");
---
<!-- Load Base Layout -->
<BaseLayout title="Wiki - RaccStarLogan" description="A collection of information about me, my work, and other random stuff.">
  <meta slot="head" name="wiki:type" content={wikiEntry.meta.type.toLowerCase()} />
  <meta slot="head" name="wiki:tags" content={wikiEntry.meta.tags.join(",")} />
  <link rel="stylesheet" href="/wiki.css" />
  <link rel="stylesheet" href={wikiEntry.stylesheet} />
  <div class="wiki-page-grid">
        <aside class="wiki-sidebar">
      <h2>Info box</h2>
      <WikiGallery
        ariaLabel="Zeke Harborne Gallery"
        images={[
          {
            src: "https://media.raccstarlogan.com/wiki/assets/zeke/1.png",
            alt: "Zeke Harborne Main Outfit",
            label: "Main Outfit",
            caption: "Zeke is often seen wearing cargo shorts, a severely ill-fitting tank top, and a necklace with a key."
          },
          {
            src: "https://media.raccstarlogan.com/wiki/assets/zeke/2.png",
            alt: "Zeke Harborne Nude",
            label: "Nude",
            caption: "Underneath his clothing, there isn't anything too notable that we can't already see with his clothes on. He's got stretch marks, but we could already see those with his ill-fitting shirt."
          }
        ]} />
      <table>
        <tbody>
          <tr>
            <th>Aliases / Nicknames</th>
            <td>TODO</td>
          </tr>
          <tr>
            <th>Birthday</th>
            <td>TODO</td>
          </tr>
          <tr>
            <th>Gender</th>
            <td>TODO</td>
          </tr>
          <tr>
            <th>Pronouns</th>
            <td>TODO</td>
          </tr>
          <tr>
            <th>Height</th>
            <td>TODO</td>
          </tr>
          <tr>
            <th>Orientation</th>
            <td>TODO</td>
          </tr>
          <tr>
            <th>Species</th>
            <td>TODO</td>
          </tr>
          <tr>
            <th>Likes</th>
            <td>TODO</td>
          </tr>
          <tr>
            <th>Dislikes</th>
            <td>TODO</td>
          </tr>
        </tbody>
      </table>
      <br/>
      <h2>More links</h2>
      <ul>
        <li><a href={wikiEntry.href + "/gallery"}>Gallery</a></li>
        {wikiEntry.referencePackUrl && (
          <li><a href={wikiEntry.referencePackUrl} download>{wikiEntry.referencePackLabel ?? "Download References (.zip)"}</a></li>
        )}
      </ul>
    </aside>

        <main id="wiki-content" class="article-section">
    <h1>Zeke Harborne</h1>

    <WikiInfoBox title="Quote" variant="info">
      <p>"TODO"</p>
      <p class="wiki-gallery-caption">- Zeke Harborne</p>
    </WikiInfoBox>

    <p><strong>Zeke Harborne</strong> is TODO.</p>

    <div class="wiki-toc-wrapper"><WikiTOC /></div>

    <h2 id="section-1">Appearance</h2>
    <p>TODO</p>

    <h2 id="section-2">Personality</h2>
    <p>TODO</p>

    <h2 id="section-3">History</h2>
    <p>TODO</p>

    <h2 id="section-4">Abilities</h2>
    <p>TODO</p>

    <h2 id="section-5">Relationships</h2>
    <p>TODO</p>

    <h2 id="section-6">Trivia</h2>
    <ul>
      <li>TODO</li>
    </ul>
    <br/>
  </main>
</div>
</BaseLayout>










