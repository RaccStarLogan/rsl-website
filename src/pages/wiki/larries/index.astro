---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WikiTOC from "../../../components/WikiTOC.astro";
import WikiInfoBox from "../../../components/WikiInfoBox.astro";
import WikiAccordion from "../../../components/WikiAccordion.astro";
import { getWikiEntry } from "../../../data/wikiEntries";

const wikiEntry = getWikiEntry("larries");
---
<BaseLayout title="Wiki - Larrie's Chicken Fingers" description="Placeholder organization page.">
  <meta slot="head" name="wiki:type" content={wikiEntry.meta.type.toLowerCase()} />
  <meta slot="head" name="wiki:tags" content={wikiEntry.meta.tags.join(",")} />
  <link rel="stylesheet" href="/wiki.css" />
  <link rel="stylesheet" href={wikiEntry.stylesheet} />
  <div class="wiki-page-grid">
    <aside class="wiki-sidebar">
      <h2>Info box</h2>
      <table>
        <tr>
          <th>Founder</th>
          <td>Larrie Caine</td>
        </tr>
        <tr>
          <th>Origin</th>
          <td>City, Province</td>
        </tr>
        <tr>
          <th>Inspiration</th>
          <td><a href="https://en.wikipedia.org/wiki/Raising_Cane%27s_Chicken_Fingers" target="_blank" rel="noopener noreferrer">Raising Cane's</a></td>
        </tr>
        <tr>
          <th>Notes</th>
          <td>Popular fast-food chain specializing in chicken fingers, known for its signature sauce and casual dining experience.</td>
        </tr>
      </table>
    </aside>

    <main id="wiki-content" class="article-section">
      <h1>Larrie's Chicken Fingers</h1>
        <WikiInfoBox title="Note" variant="warning">
            This organization page is a work in progress. Information may be incomplete or subject to change as the wiki is developed.
        </WikiInfoBox>
        <p><strong>Larrie's Chicken Fingers</strong> is a popular fast-food chain specializing in chicken fingers, known for its signature sauce and casual dining experience. Founded by Larrie Caine, the chain has expanded across multiple locations, becoming a beloved spot for quick and tasty meals.</p>
      <div class="wiki-toc-wrapper"><WikiTOC /></div>

      <h2 id="overview">Overview</h2>
      <p>Starter organization page for Larrie's Chicken Fingers.</p>

      <WikiAccordion summary="Ideas to add later">
        <ul>
          <li>Brand history and regional expansion</li>
          <li>Signature food and in-universe reputation</li>
          <li>Connections to characters or major events</li>
        </ul>
      </WikiAccordion>
    </main>
  </div>
</BaseLayout>
