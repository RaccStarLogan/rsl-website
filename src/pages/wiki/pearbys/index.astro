---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WikiTOC from "../../../components/WikiTOC.astro";
import WikiInfoBox from "../../../components/WikiInfoBox.astro";
import WikiAccordion from "../../../components/WikiAccordion.astro";
import { getWikiEntry } from "../../../data/wikiEntries";

const wikiEntry = getWikiEntry("pearbys");
---
<BaseLayout title="Wiki - Pearby's" description="Placeholder organization page.">
  <meta slot="head" name="wiki:type" content={wikiEntry.meta.type.toLowerCase()} />
  <meta slot="head" name="wiki:tags" content={wikiEntry.meta.tags.join(",")} />
  <link rel="stylesheet" href="/wiki.css" />
  <link rel="stylesheet" href={wikiEntry.stylesheet} />
  <div class="wiki-page-grid">
    <aside class="wiki-sidebar">
      <h2>Info box</h2>
      <table>
        <tr>
          <th>Founders</th>
          <td>William and J.T. Pawmer</td>
        </tr>
        <tr>
          <th>Origin</th>
          <td>City, Province</td>
        </tr>
        <tr>
          <th>Inspiration</th>
          <td><a href="https://en.wikipedia.org/wiki/Applebee%27s" target="_blank" rel="noopener noreferrer">Applebee's</a></td>
        </tr>
        <tr>
          <th>Notes</th>
          <td>Restaurant chain known for its casual dining experience and Avalonian cuisine.</td>
        </tr>
      </table>
    </aside>

    <main id="wiki-content" class="article-section">
      <h1>Pearby's</h1>
      <WikiInfoBox title="Note" variant="warning">
        This organization page is a work in progress. Information may be incomplete or subject to change as the wiki is developed.
      </WikiInfoBox>
        <p><strong>Pearby's</strong> is a restaurant chain known for its casual dining experience and Avalonian cuisine. Founded by William and J.T. Pawmer, Pearby's has become a popular destination for locals and visitors alike, offering a diverse menu that celebrates the flavors of Avalona.</p>
      <div class="wiki-toc-wrapper"><WikiTOC /></div>

      <h2 id="overview">Overview</h2>
      <p>Starter organization page for Pearby's.</p>

      <WikiAccordion summary="Ideas to add later">
        <ul>
          <li>Company background and key products or services</li>
          <li>Public perception and recurring appearances</li>
          <li>Locations and historical milestones</li>
        </ul>
      </WikiAccordion>
    </main>
  </div>
</BaseLayout>
