---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WikiTOC from "../../../components/WikiTOC.astro";
import WikiInfoBox from "../../../components/WikiInfoBox.astro";
import WikiAccordion from "../../../components/WikiAccordion.astro";
import { getWikiEntry } from "../../../data/wikiEntries";

const wikiEntry = getWikiEntry("pearbys");
---
<BaseLayout title="Wiki - Pearby's" description="Placeholder organization page.">
  <meta slot="head" name="wiki:type" content={wikiEntry.meta.type.toLowerCase()} />
  <meta slot="head" name="wiki:tags" content={wikiEntry.meta.tags.join(",")} />
  <link rel="stylesheet" href="/wiki.css" />
  <link rel="stylesheet" href={wikiEntry.stylesheet} />
  <div class="wiki-page-grid">
    <aside class="wiki-sidebar">
      <h2>Info box</h2>
      <WikiInfoBox title="Quick facts" variant="info">
        Placeholder entry for Pearby's.
      </WikiInfoBox>
    </aside>

    <main id="wiki-content" class="article-section">
      <h1>Pearby's</h1>
      <WikiInfoBox title="Note" variant="info">
        This organization page is a placeholder. Expand with business details, audience, and notable references.
      </WikiInfoBox>
      <div class="wiki-toc-wrapper"><WikiTOC /></div>

      <h2 id="overview">Overview</h2>
      <p>Starter organization page for Pearby's.</p>

      <WikiAccordion summary="Ideas to add later">
        <ul>
          <li>Company background and key products or services</li>
          <li>Public perception and recurring appearances</li>
          <li>Locations and historical milestones</li>
        </ul>
      </WikiAccordion>
    </main>
  </div>
</BaseLayout>
