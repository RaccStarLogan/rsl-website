---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const slug = Astro.params.slug?.trim() ?? "";
---

<BaseLayout title={`Gallery - ${slug || "Wiki Entry"}`} description="Gallery page placeholder.">
  <main class="article-section">
    <h1>Gallery</h1>
    <p>Gallery page placeholder for <strong>{slug || "this entry"}</strong>.</p>
  </main>
</BaseLayout>

