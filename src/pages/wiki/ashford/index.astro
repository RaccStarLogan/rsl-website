---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WikiTOC from "../../../components/WikiTOC.astro";
import WikiInfoBox from "../../../components/WikiInfoBox.astro";
import WikiAccordion from "../../../components/WikiAccordion.astro";
import { getWikiEntry } from "../../../data/wikiEntries";

const wikiEntry = getWikiEntry("ashford");
---
<BaseLayout title="Wiki - Ashford" description="Placeholder location page.">
  <meta slot="head" name="wiki:type" content={wikiEntry.meta.type.toLowerCase()} />
  <meta slot="head" name="wiki:tags" content={wikiEntry.meta.tags.join(",")} />
  <link rel="stylesheet" href="/wiki.css" />
  <link rel="stylesheet" href={wikiEntry.stylesheet} />
  <div class="wiki-page-grid">
    <aside class="wiki-sidebar">
      <h2>Info box</h2>
      <table>
        <tr>
          <th>County</th>
          <td>Gabriel County</td>
        </tr>
        <tr>
          <th>Province</th>
          <td>Texaria</td>
        </tr>
        <tr>
          <th>Country</th>
          <td>United Provinces of Avalona</td>
        </tr>
        <tr>
          <th>Inspirations</th>
          <td>
            <ul>
              <li><a href="https://en.wikipedia.org/wiki/Boerne,_Texas" target="_blank" rel="noopener noreferrer">Boerne, TX</a></li>
              <li><a href="https://en.wikipedia.org/wiki/Kerrville,_Texas" target="_blank" rel="noopener noreferrer">Kerrville, TX</a></li>
              <li><a href="https://en.wikipedia.org/wiki/New_Braunfels,_Texas" target="_blank" rel="noopener noreferrer">New Braunfels, TX</a></li>
            </ul>
          </td>
        </tr>
        <tr>
          <th>Notes</th>
          <td>Smaller town known more for its outskirts than its central area due to paranormal activity.</td>
        </tr>
      </table>
    </aside>

    <main id="wiki-content" class="article-section">
      <h1>Ashford</h1>
      <WikiInfoBox title="Note" variant="warning">
        This location page is a work in progress. Information may be incomplete or subject to change as the wiki is developed.
      </WikiInfoBox>
      <p><strong>Ashford</strong> is a town located north of <a href="/wiki/san-bandera">San Bandera, Texaria</a>. It's a smaller town known more for its outskirts than its central area due to paranormal activity.</p>
      <div class="wiki-toc-wrapper"><WikiTOC /></div>

      <h2 id="overview">Overview</h2>
      <p>Starter location page for Ashford.</p>

      <WikiAccordion summary="Ideas to add later">
        <ul>
          <li>Regional overview and map notes</li>
          <li>Major cities and political structure</li>
          <li>Important historical events</li>
        </ul>
      </WikiAccordion>
    </main>
  </div>
</BaseLayout>
