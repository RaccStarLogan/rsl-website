---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WikiTOC from "../../../components/WikiTOC.astro";
import WikiInfoBox from "../../../components/WikiInfoBox.astro";
import WikiAccordion from "../../../components/WikiAccordion.astro";
import { getWikiEntry } from "../../../data/wikiEntries";

const wikiEntry = getWikiEntry("aps");
---
<BaseLayout title="Wiki - Ashford Paranormal Society" description="Placeholder organization page.">
  <meta slot="head" name="wiki:type" content={wikiEntry.meta.type.toLowerCase()} />
  <meta slot="head" name="wiki:tags" content={wikiEntry.meta.tags.join(",")} />
  <link rel="stylesheet" href="/wiki.css" />
  <link rel="stylesheet" href={wikiEntry.stylesheet} />
  <div class="wiki-page-grid">
    <aside class="wiki-sidebar">
      <h2>Info box</h2>
      <table>
        <tr>
          <th>Founder</th>
          <td style="color: black; background-color: black;">[REDACTED]</td>
        </tr>
        <tr>
          <th>Location</th>
          <td>Ashford, Texaria</td>
        </tr>
        <tr>
          <th>Inspiration</th>
          <td><a href="https://mandela-catalogue.fandom.com/wiki/Bythorne_Paranormal_Society" target="_blank" rel="noopener noreferrer">Bythorne Paranormal Society</a></td>
        </tr>
        <tr>
          <th>Notes</th>
          <td>Consists of Wyvern, Judas, probably Logan, maybe a few other people i'll figure it out</td>
        </tr>
      </table>
    </aside>

    <main id="wiki-content" class="article-section">
      <h1>Ashford Paranormal Society</h1>
      <WikiInfoBox title="Note" variant="warning">
        This organization page is a work in progress. Information may be incomplete or subject to change as the wiki is developed.
      </WikiInfoBox>
        <p><strong>Ashford Paranormal Society</strong> is a small group of paranormal investigators based in Ashford, Texaria. They are known for their investigations into local hauntings and supernatural occurrences, often sharing their findings with the public through various media channels. The society draws inspiration from the Bythorne Paranormal Society from popular web series The Mandela Catalogue, incorporating elements of their investigative approach and storytelling style into their own work.</p>
      <div class="wiki-toc-wrapper"><WikiTOC /></div>

      <h2 id="overview">Overview</h2>
      <p>Starter organization page for the Ashford Paranormal Society.</p>

      <WikiAccordion summary="Ideas to add later">
        <ul>
          <li>Founding, mission statement, and internal structure</li>
          <li>Known members and specialties</li>
          <li>Major incidents and investigation logs</li>
        </ul>
      </WikiAccordion>
    </main>
  </div>
</BaseLayout>
