---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WikiTOC from "../../../components/WikiTOC.astro";
import WikiInfoBox from "../../../components/WikiInfoBox.astro";
import WikiAccordion from "../../../components/WikiAccordion.astro";
import { getWikiEntry } from "../../../data/wikiEntries";

const wikiEntry = getWikiEntry("crossline");
---
<BaseLayout title="Wiki - CrossLine" description="Placeholder location page.">
  <meta slot="head" name="wiki:type" content={wikiEntry.meta.type.toLowerCase()} />
  <meta slot="head" name="wiki:tags" content={wikiEntry.meta.tags.join(",")} />
  <link rel="stylesheet" href="/wiki.css" />
  <link rel="stylesheet" href={wikiEntry.stylesheet} />
  <div class="wiki-page-grid">
    <aside class="wiki-sidebar">
      <h2>Info box</h2>
      <table>
        <tr>
          <th>County</th>
          <td>Bandera County</td>
        </tr>
        <tr>
          <th>Province</th>
          <td>Texaria</td>
        </tr>
        <tr>
          <th>Country</th>
          <td>United Provinces of Avalona</td>
        </tr>
        <tr>
          <th>Inspirations</th>
          <td>
            <ul>
              <li><a href="https://en.wikipedia.org/wiki/Leon_Valley,_Texas" target="_blank" rel="noopener noreferrer">Leon Valley, TX</a></li>
              <li><a href="https://en.wikipedia.org/wiki/Balcones_Heights,_Texas" target="_blank" rel="noopener noreferrer">Balcones Heights, TX</a></li>
            </ul>
          </td>
        </tr>
        <tr>
          <th>Notes</th>
          <td>Split between East and West by a major freeway. East is retail-focused with a struggling mall containing hidden gems, while West is automotive-heavy with repair shops and industrial businesses.</td>
        </tr>
      </table>
    </aside>

    <main id="wiki-content" class="article-section">
      <h1>CrossLine</h1>
      <WikiInfoBox title="Note" variant="warning">
        This location page is a work in progress. Information may be incomplete or subject to change as the wiki is developed.
      </WikiInfoBox>
      <p><strong>CrossLine</strong> is a suburb located in the northwestern part of <a href="/wiki/san-bandera">San Bandera, Texaria</a>. It is split between East and West by a major freeway. The East side is retail-focused with a struggling mall containing hidden gems, while the West side is automotive-heavy with repair shops and industrial businesses.</p>
      <div class="wiki-toc-wrapper"><WikiTOC /></div>

      <h2 id="overview">Overview</h2>
      <p>Starter location page for CrossLine.</p>

      <WikiAccordion summary="Ideas to add later">
        <ul>
          <li>Regional overview and map notes</li>
          <li>Major cities and political structure</li>
          <li>Important historical events</li>
        </ul>
      </WikiAccordion>
    </main>
  </div>
</BaseLayout>
