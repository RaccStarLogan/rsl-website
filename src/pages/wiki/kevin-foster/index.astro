---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WikiTOC from "../../../components/WikiTOC.astro";
import WikiInfoBox from "../../../components/WikiInfoBox.astro";
import WikiAccordion from "../../../components/WikiAccordion.astro";
import WikiGallery from "../../../components/WikiGallery.astro";
import { getWikiEntry } from "../../../data/wikiEntries";

const wikiEntry = getWikiEntry("kevin-foster");
---
<!-- Load Base Layout -->
<BaseLayout title="Wiki - RaccStarLogan" description="A collection of information about me, my work, and other random stuff.">
  <meta slot="head" name="wiki:type" content={wikiEntry.meta.type.toLowerCase()} />
  <meta slot="head" name="wiki:tags" content={wikiEntry.meta.tags.join(",")} />
  <link rel="stylesheet" href="/wiki.css" />
  <link rel="stylesheet" href={wikiEntry.stylesheet} />
  <div class="wiki-page-grid">
    <aside class="wiki-sidebar">
      <h2>Info box</h2>
      <WikiGallery
        ariaLabel="Kevin Foster Gallery"
        images={[
          {
            src: "https://media.raccstarlogan.com/wiki/assets/kevin/1.png",
            alt: "Kevin Foster Main Outfit",
            label: "Main Outfit",
            caption: "Kevin is often seen wearing a Rose Flow T-shirt, camo pants, and dad sandles. The Rose Flow shirt is a reference to the band Pink Floyd, altered to avoid copyright issues while still being recognizable."
          },
          {
            src: "https://media.raccstarlogan.com/wiki/assets/kevin/2.png",
            alt: "Kevin Foster Flannel",
            label: "Flannel",
            caption: "Sometimes Kevin wears a red flannel jacket over his Rose Flow shirt, especially in colder weather."
          },
          {
            src: "https://media.raccstarlogan.com/wiki/assets/kevin/3.png",
            alt: "Kevin Foster Nude",
            label: "Nude",
            captionHtml: "Underneath his clothing, Kevin's fur is very matted. Just like his son <a href=\"/wiki/logan-foster\">Logan</a>, his fur is lighter on his chest and belly, but it doesn't form any particular markings like <a href=\"/wiki/logan-foster\">Logan</a>'s heart marking."
          }
        ]} />
      <table>
        <tbody>
          <tr>
            <th>Aliases / Nicknames</th>
            <td>TODO</td>
          </tr>
          <tr>
            <th>Birthday</th>
            <td>TODO</td>
          </tr>
          <tr>
            <th>Gender</th>
            <td>TODO</td>
          </tr>
          <tr>
            <th>Pronouns</th>
            <td>TODO</td>
          </tr>
          <tr>
            <th>Height</th>
            <td>TODO</td>
          </tr>
          <tr>
            <th>Orientation</th>
            <td>TODO</td>
          </tr>
          <tr>
            <th>Species</th>
            <td>TODO</td>
          </tr>
          <tr>
            <th>Likes</th>
            <td>TODO</td>
          </tr>
          <tr>
            <th>Dislikes</th>
            <td>TODO</td>
          </tr>
        </tbody>
      </table>
      <br/>
      <h2>More links</h2>
      <ul>
        <li><a href={wikiEntry.href + "/gallery"}>Gallery</a></li>
        {wikiEntry.referencePackUrl && (
          <li><a href={wikiEntry.referencePackUrl} download>{wikiEntry.referencePackLabel ?? "Download References (.zip)"}</a></li>
        )}
      </ul>
    </aside>

    <main id="wiki-content" class="article-section">
    <h1>Kevin Foster</h1>

    <WikiInfoBox title="Quote" variant="info">
      <p>"TODO"</p>
      <p class="wiki-gallery-caption">- Kevin Foster</p>
    </WikiInfoBox>

    <p><strong>Kevin Foster</strong> is TODO.</p>

    <div class="wiki-toc-wrapper"><WikiTOC /></div>

    <h2 id="section-1">Appearance</h2>
    <p>TODO</p>

    <h2 id="section-2">Personality</h2>
    <p>TODO</p>

    <h2 id="section-3">History</h2>
    <p>TODO</p>

    <h2 id="section-4">Abilities</h2>
    <p>TODO</p>

    <h2 id="section-5">Relationships</h2>
    <p>TODO</p>

    <h2 id="section-6">Trivia</h2>
    <ul>
      <li>TODO</li>
    </ul>
    <br/>
  </main>
</div>
</BaseLayout>









