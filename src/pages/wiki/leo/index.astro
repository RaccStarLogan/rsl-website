---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WikiTOC from "../../../components/WikiTOC.astro";
import WikiInfoBox from "../../../components/WikiInfoBox.astro";
import WikiAccordion from "../../../components/WikiAccordion.astro";
import WikiGallery from "../../../components/WikiGallery.astro";
import { getWikiEntry } from "../../../data/wikiEntries";

const wikiEntry = getWikiEntry("leo");
---
<!-- Load Base Layout -->
<BaseLayout title="Wiki - RaccStarLogan" description="A collection of information about me, my work, and other random stuff.">
  <meta slot="head" name="wiki:type" content={wikiEntry.meta.type.toLowerCase()} />
  <meta slot="head" name="wiki:tags" content={wikiEntry.meta.tags.join(",")} />
  <link rel="stylesheet" href="/wiki.css" />
  <link rel="stylesheet" href={wikiEntry.stylesheet} />
  <div class="wiki-page-grid">
        <aside class="wiki-sidebar">
      <h2>Info box</h2>
      <WikiGallery 
        ariaLabel="Leo Gallery"
        images={[
            {
                src: "https://media.raccstarlogan.com/wiki/assets/leo.png",
                alt: "Leo the Wickerbeast",
                caption: "that's me leo im blue with a purple tummy and theres a blue line across my belly"
            }
        ]} />
      <table>
        <tbody>
          <tr>
            <th>Aliases / Nicknames</th>
            <td>
              <ul>
                <li>@n00nie</li>
                <li>blueberry</li>
              </ul>
            </td>
          </tr>
          <tr>
            <th>Birthday</th>
            <td>march 3</td>
          </tr>
          <tr>
            <th>Gender</th>
            <td>male</td>
          </tr>
          <tr>
            <th>Pronouns</th>
            <td>he/it</td>
          </tr>
          <tr>
            <th>Height</th>
            <td>9 ft / 274 cm</td>
          </tr>
          <tr>
            <th>Orientation</th>
            <td>whats that</td>
          </tr>
          <tr>
            <th>Species</th>
            <td>swamp wickerbeast</td>
          </tr>
          <tr>
            <th>Hobbies</th>
            <td>
              <ul>
                <li>fishing</li>
                <li>swimming</li>
                <li>eating</li>
                <li>sleeping</li>
              </ul>
            </td>
          </tr>
          <tr>
            <th>Favorite Foods</th>
            <td>
              <ul>
                <li>blueberries</li>
                <li>fish</li>
                <li>everything!</li>
              </ul>
            </td>
          </tr>
          <tr>
            <th>Likes</th>
            <td>
              <ul>
                <li>fishing</li>
                <li>being lazy</li>
                <li>eating</li>
                <li>raccoons</li>
                <li>blue</li>
              </ul>
            </td>
          </tr>
          <tr>
            <th>Dislikes</th>
            <td>
              <ul>
                <li>small places</li>
                <li>mean people</li>
                <li>rushing</li>
                <li>seriousness</li>
              </ul>
            </td>
          </tr>
        </tbody>
      </table>
      <br/>
      <h2>More links</h2>
      <ul>
        <li><a href={wikiEntry.href + "/gallery"}>Gallery</a></li>
        {wikiEntry.referencePackUrl && (
          <li><a href={wikiEntry.referencePackUrl} download>{wikiEntry.referencePackLabel ?? "Download References (.zip)"}</a></li>
        )}
      </ul>
    </aside>

        <main id="wiki-content" class="article-section">
    <h1>Leo</h1>

    <WikiInfoBox title="Quote" variant="info">
      <p>"i like blueberrys"</p>
      <p class="wiki-gallery-caption">- me</p>
    </WikiInfoBox>

    <p>hi my name is <strong style="color: var(--wiki-accent-color);">leo</strong> logan told me to tell you im not cannon to <a href="/wiki/redrift">redrift</a> or whatever idk what that means but here's my wiki page! :D</p>

    <div class="wiki-toc-wrapper"><WikiTOC /></div>

    <h2 id="section-1">Appearance</h2>
    <p>im a big fat wickerbeast from the swamp im blue and i have a purple tummy with a blue line going across it people call me blueberry because im so blue and round</p>
    <p>my claws are chunky with webs or something in between them and i also have a tail with stripes and spikes</p>
    <p>i dont really fit in any clothes so i dont wear any but i think its funny to play dress up sometimes :3</p>
    <p>logan told me to say i slouch when i walk but idk what that means</p>

    <h2 id="section-2">Personality</h2>
    <p>im very silly and lazy i dont do a lot unless its fun or involves food</p>
    <p>sometimes i nap in random places and forget where i am when i wake up</p>
    <p>im very friendly! i love everyone :3 i hope i can be freidns with everyone :o</p>

    <h2 id="section-3">History</h2>
    <p>i dont know what this is im gonna make logan write this for me</p>
    <p>Leo was created in a lab from a sample of <a href="/wiki/logan-foster"></a>Logan</a>'s DNA. The reasoning behind this has since been forgotten, but I don't remember giving them permission to use my DNA in that way. I just wanted to see if <a href="/wiki/jesper-foster">Jesper</a> was indeed my brother; I guess I just clicked the checkbox allowing them to use it without actually reading into what it meant??? It's whatever, we don't worry about that.</p>
    <p>I'm giving this back to Leo. Hopefully he doesn't read this section, I don't think he'd take being an accident too well...</p>

    <h2 id="section-4">Abilities</h2>
    <p>TODO</p>

    <h2 id="section-5">Relationships</h2>
    <p>TODO</p>

    <h2 id="section-6">Trivia</h2>
    <ul>
      <li>people call me blueberry a lot</li>
      <li>i like blueberrys</li>
      <li>one time i stared at a frog until i realized it was a rock</li>
      <li>fishing is fun</li>
      <li>once i ate a candle it was spicy</li>
      <li>turtles do not make good hats their too heavy</li>
    </ul>
    <br/>
  </main>
</div>
</BaseLayout>

