---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WikiTOC from "../../../components/WikiTOC.astro";
import WikiInfoBox from "../../../components/WikiInfoBox.astro";
import WikiAccordion from "../../../components/WikiAccordion.astro";
import { getWikiEntry } from "../../../data/wikiEntries";

const wikiEntry = getWikiEntry("austyn");
---
<BaseLayout title="Wiki - Austyn" description="Placeholder location page.">
  <meta slot="head" name="wiki:type" content={wikiEntry.meta.type.toLowerCase()} />
  <meta slot="head" name="wiki:tags" content={wikiEntry.meta.tags.join(",")} />
  <link rel="stylesheet" href="/wiki.css" />
  <link rel="stylesheet" href={wikiEntry.stylesheet} />
  <div class="wiki-page-grid">
    <aside class="wiki-sidebar">
      <h2>Info box</h2>
      <table>
        <tr>
          <th>County</th>
          <td>Austyn County</td>
        </tr>
        <tr>
          <th>Province</th>
          <td>Texaria</td>
        </tr>
        <tr>
          <th>Country</th>
          <td>United Provinces of Avalona</td>
        </tr>
        <tr>
          <th>Inspiration</th>
          <td><a href="https://en.wikipedia.org/wiki/Austin,_Texas" target="_blank" rel="noopener noreferrer">Austin, TX</a></td>
        </tr>
        <tr>
          <th>Notes</th>
          <td>Capital city of Texaria, known for its vibrant culture and tech industry.</td>
        </tr>
      </table>
    </aside>

    <main id="wiki-content" class="article-section">
      <h1>Austyn</h1>
      <WikiInfoBox title="Note" variant="warning">
        This location page is a work in progress. Information may be incomplete or subject to change as the wiki is developed.
      </WikiInfoBox>
        <p><strong>Austyn</strong> is the capital city of Texaria, located in the central part of the province. It's known for its vibrant culture, music scene, and growing tech industry. Austyn serves as a major hub for commerce, government, and entertainment within Texaria.</p>
      <div class="wiki-toc-wrapper"><WikiTOC /></div>

      <h2 id="overview">Overview</h2>
      <p>Starter location page for Austyn.</p>

      <WikiAccordion summary="Ideas to add later">
        <ul>
          <li>Regional significance and role in Texaria</li>
          <li>Landmarks, districts, and public services</li>
          <li>Notable people and events tied to the city</li>
        </ul>
      </WikiAccordion>
    </main>
  </div>
</BaseLayout>
