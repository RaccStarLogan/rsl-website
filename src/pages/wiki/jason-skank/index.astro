---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WikiTOC from "../../../components/WikiTOC.astro";
import WikiInfoBox from "../../../components/WikiInfoBox.astro";
import WikiAccordion from "../../../components/WikiAccordion.astro";
import WikiGallery from "../../../components/WikiGallery.astro";
import { getWikiEntry } from "../../../data/wikiEntries";

const wikiEntry = getWikiEntry("jason-skank");
---
<!-- Load Base Layout -->
<BaseLayout title="Wiki - RaccStarLogan" description="A collection of information about me, my work, and other random stuff.">
  <meta slot="head" name="wiki:type" content={wikiEntry.meta.type.toLowerCase()} />
  <meta slot="head" name="wiki:tags" content={wikiEntry.meta.tags.join(",")} />
  <link rel="stylesheet" href="/wiki.css" />
  <link rel="stylesheet" href={wikiEntry.stylesheet} />
  <div class="wiki-page-grid">
        <aside class="wiki-sidebar">
      <h2>Info box</h2>
      <WikiGallery
        ariaLabel="Jason Skank Gallery"
        images={[
          {
            src: "https://media.raccstarlogan.com/wiki/assets/jason/1.png",
            alt: "Jason Skank Clothed",
            label: "Clothed",
            caption: "Jason can usually be found wearing a black denim vest with the sleeves ripped off and blue jeans."
          },
          {
            src: "https://media.raccstarlogan.com/wiki/assets/jason/2.png",
            alt: "Jason Skank Nude",
            label: "Nude",
            caption: "Underneath Jason's jacket, you can see his gills. and scars. It's unclear where his gills actually are, but they are on his chest."
          }
        ]} />
      <table>
        <tbody>
          <tr>
            <th>Aliases / Nicknames</th>
            <td>
              <ul>
                <li>@JSON.SKNAK</li>
                <!-- it's xXx_JSON.SKNAK_xXx but I'm too lazy to change the css to make the table fit this in -->
                <li>Jay</li>
                <li>JJ</li>
              </ul>
            </td>
          </tr>
          <tr>
            <th>Birthday</th>
            <td>July 14, 1996</td>
          </tr>
          <tr>
            <th>Gender</th>
            <td>Male</td>
          </tr>
          <tr>
            <th>Pronouns</th>
            <td>he/him</td>
          </tr>
          <tr>
            <th>Height</th>
            <td>6 ft 6 in / 198 cm</td>
          </tr>
          <tr>
            <th>Orientation</th>
            <td>Straight</td>
          </tr>
          <tr>
            <th>Species</th>
            <td>Night Shark</td>
          </tr>
          <tr>
            <th>Occupation</th>
            <td>Mercenary</td>
          </tr>
          <tr>
            <th>Residence</th>
            <td>SouthPort, Texaria</td>
          </tr>
          <tr>
            <th>Hobbies</th>
            <td>
              <ul>
                <li>Starting Fights</li>
                <li>Attention Seeking</li>
                <li>Clubbing</li>
              </ul>
            </td>
          </tr>
          <tr>
            <th>Favorite Foods</th>
            <td>
              <ul>
                <li>Raw Fish</li>
                <li>Energy Drinks</li>
                <li>Seaweed Snacks</li>
                <li>Krill</li>
              </ul>
            </td>
          </tr>
          <tr>
            <th>Likes</th>
