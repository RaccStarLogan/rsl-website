                <li>Women</li>
              </ul>
            </td>
          </tr>
          <tr>
            <th>Dislikes</th>
            <td>
              <ul>
                <li><a href="/wiki/jesper-foster">Jesper</a></li>
                <li>LGBTQIA+</li>
                <li>Losing</li>
                <li>Being Ignored</li>
