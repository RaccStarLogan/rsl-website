---
import NSFWLayout from "../../layouts/NSFWLayout.astro";
import WikiInfoBox from "../../components/WikiInfoBox.astro";
import WikiAccordion from "../../components/WikiAccordion.astro";
import { wikiEntries } from "../../data/wikiEntries";

const featuredEntries = [...wikiEntries]
  .sort(() => Math.random() - 0.5)
  .slice(0, 3);
---

<!-- Load Base Layout -->
<NSFWLayout
  title="Wiki - Jesper Skulldragon"
  description="A simple place to browse characters and other bits of the world around them."
>
  <link rel="stylesheet" href="/wiki.css" />
  <div class="wiki-page-grid">
    <aside class="wiki-sidebar">
      <h2>Info box</h2>
      <WikiInfoBox title="Quick facts" variant="info">
        Use this area for quick metadata, related links, or a summary box like a
        wiki info panel.
      </WikiInfoBox>
      <h2>More links</h2>
      <ul>
        <li><a href="/links">Links</a></li>
        <li><a href="/portfolio">Portfolio</a></li>
        <li><a href="/commissions">Commissions</a></li>
      </ul>
    </aside>

    <main id="wiki-content" class="article-section">
      <h1>Welcome to the RSL Wiki</h1>

      <WikiInfoBox title="What this is" variant="info">
        This is a simple index for the people, stories, and bits of worldbuilding
        collected across the site. If you want to look around, this is the place
        to start.
      </WikiInfoBox>

      <div class="wiki-toc-wrapper">
        <aside class="wiki-toc">
          <details class="wiki-toc-details">
            <summary>Table of Contents</summary>
            <nav id="wiki-toc" aria-label="Wiki subpages">
              {
                wikiEntries.map((page) => (
                  <a href={page.href}>{page.label}</a>
                ))
              }
            </nav>
          </details>
        </aside>
      </div>

      <h2 id="getting-started">Getting Started</h2>
      <p>
        The table of contents above links to each page in the wiki. Pick a name,
        click through, and browse from there.
      </p>

      <WikiAccordion summary="What you will find here">
        <p>
          Most of the pages here are character profiles, but this section can also
          grow into a home for relationship notes, setting details, and anything
          else tied to the project.
        </p>
        <ul>
          <li>Character pages collect the basics in one place.</li>
          <li>Some pages may focus more on story context or setting notes.</li>
          <li>The list will keep growing over time.</li>
        </ul>
      </WikiAccordion>

      <h2 id="featured-index">Featured Index</h2>
      <table aria-label="Featured wiki entries">
        <thead>
          <tr>
            <th>Entry</th>
            <th>Type</th>
          </tr>
        </thead>
        <tbody>
          {
            featuredEntries.map((entry) => (
              <tr>
                <td><a href={entry.href}>{entry.label}</a></td>
                <td>{entry.meta.type}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </main>
  </div>
</NSFWLayout>
