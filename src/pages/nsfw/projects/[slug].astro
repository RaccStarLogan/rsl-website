---
import NSFWLayout from "../../../layouts/NSFWLayout.astro";
import { getProjectDetail } from "../../../lib/portfolio/repository";

const slug = Astro.params.slug;
const project = slug
  ? await getProjectDetail(slug, "nsfw", Astro.locals)
  : null;

if (!project) {
  Astro.response.status = 404;
}
---

<NSFWLayout
  title={project ? `${project.item.title} - Project` : "Project Not Found"}
  description={project?.item.summary ?? "Project not found."}
>
  <link rel="stylesheet" href="/styles/layouts/portfolio.css" />

  {
    project ? (
      <article class="project-page">
        <header class="project-page-hero">
          <img src={project.item.thumbnailUrl} alt={project.item.title} class="project-page-thumb" />
          <div>
            <h1>{project.item.title}</h1>
            <p>{project.item.summary}</p>
            {project.item.externalUrl && (
              <p><a href={project.item.externalUrl} target="_blank" rel="noopener noreferrer">External Link</a></p>
            )}
          </div>
        </header>
        <section class="project-page-sections">
          {project.sections.map((section) => (
            <section class="project-section">
              <h2>{section.heading}</h2>
              <p>{section.body}</p>
            </section>
          ))}
        </section>
      </article>
    ) : (
      <section class="project-page not-found">
        <h1>Project not found</h1>
        <p>This project either does not exist yet or is hidden by visibility settings.</p>
        <p><a href="/nsfw/portfolio">Return to portfolio</a></p>
      </section>
    )
  }
</NSFWLayout>
