---
import NSFWLayout from "../../../layouts/NSFWLayout.astro";
import ProjectCards from "../../../components/ProjectCards.astro";
---

<NSFWLayout title="Portfolio Projects - Jesper Skulldragon" description="NSFW large scale project portfolio.">
  <link rel="stylesheet" href="/nsfw/portfolio.css" />

  <div class="portfolio-page">
    <section class="portfolio-hero">
      <h1>Big Scale Projects</h1>
      <p>Each project card opens a dedicated project page.</p>
      <nav class="portfolio-jump-links" aria-label="Portfolio navigation">
        <a href="/nsfw/portfolio">All Sections</a>
        <a href="/nsfw/portfolio/art">Art</a>
        <a href="/nsfw/portfolio/music">Music</a>
      </nav>
    </section>

    <ProjectCards
      title="Big Scale Projects"
      description="WORK IN PROGRESS"
      visibility="nsfw"
      linkPrefix="/nsfw/projects"
    />
  </div>
</NSFWLayout>
