---
import NSFWLayout from "../../../../layouts/NSFWLayout.astro";
import PortfolioGallery from "../../../../components/PortfolioGallery.astro";
---

<NSFWLayout title="Portfolio Music - Jesper Skulldragon" description="NSFW music portfolio with filters.">
  <link rel="stylesheet" href="/nsfw/portfolio.css" />

  <div class="portfolio-page">
    <section class="portfolio-hero">
      <h1>Music Portfolio</h1>
      <p>Thumbnail gallery view. Hover for title, click for full info.</p>
      <nav class="portfolio-jump-links" aria-label="Portfolio navigation">
        <a href="/nsfw/portfolio">All Sections</a>
        <a href="/nsfw/portfolio/art">Art</a>
        <a href="/nsfw/portfolio/projects">Big Scale Projects</a>
      </nav>
    </section>

    <PortfolioGallery
      title="Music Gallery"
      description="Hover a thumbnail to see title. Click to open full details."
      kind="music"
      visibility="nsfw"
      detailBasePath="/nsfw/portfolio/music"
      containerId="music-gallery-nsfw"
    />
  </div>
</NSFWLayout>
